# Copy to .env.local (never commit .env.local)
# Local: values printed by `npx supabase status`
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key

# Payments (Phase 2). Provider: paystack | none. Use the Paystack TEST public key (pk_test_...) only.
# Public keys are safe in the browser; the SECRET key lives only in Supabase Edge Function secrets.
VITE_PAYMENT_PROVIDER=paystack
VITE_PAYSTACK_PUBLIC_KEY=
