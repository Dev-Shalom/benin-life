# Security headers for every page (docs/SECURITY.md). Deliberately NO script/style Content-Security-Policy: it could break the
# game (inline styles, three.js, Paystack and Turnstile scripts). frame-ancestors only stops other sites from framing the game.
/*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(self), microphone=(self), geolocation=(self)

/assets/*
  Cache-Control: public, max-age=31536000, immutable
/art/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/sw.js
  Cache-Control: no-cache, must-revalidate
/version.json
  Cache-Control: no-cache, must-revalidate
/manifest.webmanifest
  Cache-Control: no-cache, must-revalidate
/index.html
  Cache-Control: no-cache, must-revalidate
